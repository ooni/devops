<clickhouse>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <trace_log remove="1"/>
    <max_server_memory_usage_to_ram_ratio>0.5</max_server_memory_usage_to_ram_ratio>
    <remote_servers>
        <oonidata_cluster>
            <shard>
                <internal_replication>true</internal_replication>
                <replica><host>data1</host><port>9000</port><user>admin</user><password>admin</password></replica>
                <replica><host>data2</host><port>9000</port><user>admin</user><password>admin</password></replica>
                <replica><host>data3</host><port>9000</port><user>admin</user><password>admin</password></replica>
            </shard>
        </oonidata_cluster>
    </remote_servers>
    <zookeeper><node><host>keeper</host><port>9181</port></node></zookeeper>
    <distributed_ddl><path>/clickhouse/task_queue/ddl</path></distributed_ddl>
    <!-- like the role's ooni_backup_s3.xml: credentials per bucket, so queries carry none -->
    <s3>
        <b1><endpoint>http://minio:9000/ooni-clickhouse-backup/</endpoint><access_key_id>testkey</access_key_id><secret_access_key>testsecret123</secret_access_key></b1>
        <b2><endpoint>http://minio:9000/ooni-clickhouse-backup-private/</endpoint><access_key_id>testkey</access_key_id><secret_access_key>testsecret123</secret_access_key></b2>
    </s3>
</clickhouse>
