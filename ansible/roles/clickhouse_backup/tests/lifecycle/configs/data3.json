{
  "database": "ooni",
  "cluster": "oonidata_cluster",
  "clickhouse_url": "http://data3:8123/",
  "clickhouse_user": "admin",
  "clickhouse_password": "admin",
  "s3_endpoint": "http://minio:9000",
  "s3_prefix": "prod",
  "s3_access_key_id": "testkey",
  "s3_secret_access_key": "testsecret123",
  "exclude_tables": [
    "*_tmp",
    "msmt_feedback_old",
    "fingerprints_dns",
    "fingerprints_http",
    "session_expunge"
  ],
  "keep_chains": 2,
  "poll_interval_seconds": 1,
  "lock_file": "/tmp/data3.lock",
  "state_file": "/tmp/data3.state.json",
  "metrics_file": "/tmp/data3.prom",
  "jobs": [
    {
      "name": "measurements",
      "s3_bucket": "ooni-clickhouse-backup",
      "include_tables": [
        "*"
      ],
      "exclude_tables": [
        "msmt_feedback",
        "faulty_measurements",
        "url_priorities",
        "labeling_frames",
        "event_detector_cusums",
        "event_detector_v2_changepoints",
        "changepoint_label"
      ]
    },
    {
      "name": "private",
      "s3_bucket": "ooni-clickhouse-backup-private",
      "include_tables": [
        "msmt_feedback",
        "faulty_measurements",
        "url_priorities"
      ],
      "exclude_tables": []
    }
  ]
}