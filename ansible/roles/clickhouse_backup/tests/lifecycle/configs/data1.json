{
  "database": "ooni",
  "cluster": "oonidata_cluster",
  "clickhouse_url": "http://data1:8123/",
  "clickhouse_user": "admin",
  "clickhouse_password": "admin",
  "s3_endpoint": "http://minio:9000",
  "s3_prefix": "prod",
  "s3_access_key_id": "testkey",
  "s3_secret_access_key": "testsecret123",
  "exclude_tables": [
    "*_tmp",
    "msmt_feedback_old",
    "fingerprints_dns",
    "fingerprints_http",
    "session_expunge"
  ],
  "keep_chains": 2,
  "poll_interval_seconds": 1,
  "lock_file": "/tmp/data1.lock",
  "state_file": "/tmp/data1.state.json",
  "metrics_file": "/tmp/data1.prom",
  "jobs": [
    {
      "name": "data1",
      "s3_bucket": "ooni-clickhouse-backup",
      "include_tables": [
        "labeling_frames",
        "event_detector_cusums",
        "event_detector_v2_changepoints",
        "changepoint_label"
      ],
      "exclude_tables": []
    }
  ]
}