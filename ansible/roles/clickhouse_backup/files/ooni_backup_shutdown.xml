<?xml version="1.0"?>
<!-- Installed by the clickhouse_backup role.
     When stopping, cancel running backups rather than wait for them: a full
     backup takes more than a day, and clickhouse-server.service has
     TimeoutStopSec=infinity, so a restart (e.g. for a security update) would
     hang until it finished. The backup script starts a cancelled table again
     once ClickHouse is back, or after a reboot. Read at startup only: it takes
     effect from the next restart. -->
<clickhouse>
    <shutdown_wait_backups_and_restores>false</shutdown_wait_backups_and_restores>
</clickhouse>
