# ansible-managed in ooni/devops.git (roles/datadumps)
[Unit]
Description=Generate and rotate weekly data dumps for {{ datadumps_domain }}
After=network-online.target clickhouse-server.service

[Service]
Type=oneshot
User={{ datadumps_user }}
Group={{ datadumps_user }}
ExecStart=/usr/bin/python3 {{ datadumps_install_dir }}/datadumps.py \
    --output-dir {{ datadumps_output_dir }} \
    --queries-dir {{ datadumps_install_dir }}/queries \
    --keep {{ datadumps_keep_weeks }} \
    --grace-hours {{ datadumps_grace_hours }} \
    --clickhouse-host {{ datadumps_clickhouse_host }}
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ datadumps_output_dir }}
